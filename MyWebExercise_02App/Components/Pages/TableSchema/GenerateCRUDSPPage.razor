    private async Task GenerateCSharpClass()
    {
        if (SelectedSource == "db" && string.IsNullOrEmpty(selectedDbName))
        {
            // 顯示錯誤訊息，請選擇資料庫
            Snackbar.Add("請選擇資料庫", Severity.Error);
            return;
        }
        var usings = new List<string>
        {
            "using System;",
            "using System.Collections.Generic;",
            "using System.Text;"
        };
        var exportModel = new MyDbModel()
        {
            NameSpace = classNameSpace,
            Usings = usings,
            Tables = tables.Where(t => selectedItems.Contains(t)).ToList()
        };

        var httpContext = HttpContextAccessor.HttpContext;

        //string filePath = $"template/liquid/cSharp/class.liquid";
        //string templatePath = Path.Combine(Environment.WebRootPath, filePath);
        string templatePath = templateFiles.GetValueOrDefault(Path.GetFileName(selectedTemplateFile));
        if (!File.Exists(templatePath))
        {
            Snackbar.Add("template 檔案不存在", Severity.Error);
            return;
        }

        var templateContent = await File.ReadAllTextAsync(templatePath);
        Template template = Template.Parse(templateContent);

        var files = new Dictionary<string, string>();
        foreach (var table in exportModel.Tables)
        {
            var fileContent = template.Render(Hash.FromAnonymousObject(new { usings = exportModel.Usings, name_space = exportModel.NameSpace, table = table }));
            var templateNameWitoutExtension = Path.GetFileNameWithoutExtension(templatePath);
            var extensionName = GetSubFilename(templateNameWitoutExtension) == "sql" ? $"_{templateNameWitoutExtension}" : "";
            var downloadFile = $"{table.TableName}{extensionName}.{GetSubFilename(templateNameWitoutExtension)}";
            files.Add(downloadFile, fileContent);
        }

        // 建立記憶體串流
        using var memorystream = new MemoryStream();

        //建立 ZipArchive 物件
        using (var archive = new System.IO.Compression.ZipArchive(memorystream, System.IO.Compression.ZipArchiveMode.Create, true))
        {
            foreach (var file in files)
            {
                var zipEntry = archive.CreateEntry(file.Key);

                using var entryStream = zipEntry.Open();
                using var streamWriter = new StreamWriter(entryStream, System.Text.Encoding.UTF8);
                await streamWriter.WriteAsync(file.Value);
            }
        }

        memorystream.Position = 0;
        var outputPath = $"{selectedDbName}_{Path.GetFileNameWithoutExtension(templatePath)}.zip";
        var zipFileContent = memorystream.ToArray();
        await JS.InvokeVoidAsync("downloadFile", outputPath,
             "application/zip",
            zipFileContent);
    }

    private string GetSubFilename(string fileName)
    {
        return fileName switch { 
            "class" => "cs",
            "createTableSql" => "sql",
            "GenTableCrudTvpSp" => "sql",
            _ => "txt"
        };   
    }

