    }
}

@code 
{
    private IBrowserFile _uploadFile;
    private bool _uploading;
    private readonly int _uploadMin = 0;
    private readonly int _uploadMax = 100;
    private int _uploadValue = 0;

    public async Task Upload()
    {
        if (_uploadFile == null) return;
        
        tables = new List<DbTable>();
        _uploading = true;
        StateHasChanged();

        // 將 IBrowserFile 轉為 Stream
        using var stream = _uploadFile.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024); // 限制 100MB
        var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        memoryStream.Position = 0;

        //-----------------------
        await foreach (var result in ExcelService.ImportExcelTableSchemaAsync(memoryStream, _uploadFile.Name))
        {
            var (table, current, total) = result;

            _uploadValue = (int)((current / (double)total) * 100);
            StateHasChanged();

            if (table != null)
            {
                if (!tables.Any(t => t.TableFullName == table.TableFullName))
                {
                    tables.Add(table);
                }
            }
            else
            {
                Snackbar.Add($"Failed to import row {current} of {total}", Severity.Error);
            }
        }
        //--------------------------

        _uploadFile = default;
        _uploading = false;
        Snackbar.Add("匯入成功", Severity.Success);
        if (tables.Any())
            selectedDbName = tables.FirstOrDefault().DatabaseName;
        selectedItems = tables.ToHashSet();
        IsCanRun = true;
    }
}