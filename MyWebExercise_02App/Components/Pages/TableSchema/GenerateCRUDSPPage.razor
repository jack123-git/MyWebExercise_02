@page "/generatesp"
@inject IWebHostEnvironment Environment
@inject IDatabaseRepository DatabaseRepository
@inject IMiniWordService MiniWordService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IHttpContextAccessor HttpContextAccessor
@inject IExcelService ExcelService

<PageTitle>Sp處理</PageTitle>

<MudText Typo="Typo.h5">Sp處理</MudText>
<MudDivider></MudDivider>
<MudPaper Class="pt-4 pl-4" Outlined="true">
    <MudPaper Style="width:300px;">
        <MudTextField Typo="Typo.body1" Class="py-4" Label="命名空間" Style="width:300px;" @bind-Value="classNameSpace" />
        <MudSelect @bind-Value="selectedTemplateFile" Label="選取範本" HelperText="選取範本" OpenIcon="@Icons.Material.Filled.FactCheck" AdornmentColor="Color.Secondary" Dense>
            @foreach (var item in templateFiles)
            {
                <MudSelectItem Value="@item.Value">@item.Key</MudSelectItem>
            }
        </MudSelect>
    </MudPaper>
    
    <div class="d-flex" style="width:60%;">
        <MudText Typo="Typo.body1" Class="pt-4">資料來源</MudText>
        <MudRadioGroup @bind-Value="SelectedSource">
            <MudRadio Value="@("db")" Color="Color.Primary">Db</MudRadio>
            <MudRadio Value="@("excel")" Color="Color.Secondary">Excel</MudRadio>
        </MudRadioGroup>
    </div>
    <MudCollapse Expanded="@(SelectedSource == "db")" Class="px-4 mx-4">
        <MudPaper class="d-flex gap-4" Style="width:20%;height:70px">
            <MudSelect @bind-Value="selectedDbName" Label="選取資料庫" HelperText="選取資料庫" OpenIcon="@Icons.Material.Filled.FactCheck" AdornmentColor="Color.Secondary" Dense>
                @foreach (string item in databaseNames)
                {
                    <MudSelectItem Value="@item">@item</MudSelectItem>
                }
            </MudSelect>
            <MudButton Color="Color.Primary" Variant="@Variant.Outlined" OnClick="GetTableList" Class="mt-3" Style="height:35px">
                讀取
            </MudButton>
        </MudPaper>
    </MudCollapse>
    <MudCollapse Expanded="@(SelectedSource == "excel")" Class="pa-4 mx-4">
        <MudFileUpload @bind-Files=@_uploadFile Class="mud-width-full">
            <CustomContent>
                <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled" Class="mud-width-full">
                    <MudButton Variant="Variant.Filled" OnClick="@context.OpenFilePickerAsync" Style="min-width: 150px;">
                        選擇Excel檔案
                    </MudButton>
                    <MudPaper Class="mud-width-full flex-wrap d-flex align-center justify-center mud-border-secondary mud-text-secondary"
                              Style="width:500px;background-color:inherit;"
                              Outlined="true">
                        @if (_uploading)
                        {
                            <MudProgressLinear Class="mx-2" Color="Color.Tertiary" Size="Size.Large" Value="_uploadValue" Min="_uploadMin" Max="_uploadMax" />
                        }
                        else
                        {
                            @(context.GetFilenames().Count > 0 ? context.GetFilenames()[0] : " ")
                        }
                    </MudPaper>
                    <MudButton Variant="Variant.Filled" OnClick="@Upload" Disabled="@(!context.GetFilenames().Any())">
                        匯入
                    </MudButton>
                </MudButtonGroup>
            </CustomContent>
            <SelectedTemplate />
        </MudFileUpload>        
    </MudCollapse>
    @if (tables.Count > 0)
    {
        <div style="width:20%;">
            <MudText Typo="Typo.body1" Class="pt-4">資料表</MudText>
            <MudTable T="DbTable" Items="@tables" MultiSelection="true" SelectionChangeable="true" Hover="true" Dense
                      @bind-SelectedItems="selectedItems" SelectOnRowClick="true">
                <HeaderContent>
                    <MudTh>資料表</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Name">@context.TableName</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                </PagerContent>
            </MudTable>
        </div>
    }

@*     <MudButton Color="Color.Primary" Variant="@Variant.Outlined" OnClick="GenerateSP" Disabled="!IsCanRun">
        產生Word文件
    </MudButton> *@
    <MudButton Color="Color.Primary" Variant="@Variant.Outlined" OnClick="GenerateCSharpClass" Disabled="!IsCanRun">
        產生Zip檔案
    </MudButton>
</MudPaper>

