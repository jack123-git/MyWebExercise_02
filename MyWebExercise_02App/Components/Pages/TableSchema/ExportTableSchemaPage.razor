@page "/exportdbschema"
@inject IWebHostEnvironment Environment
@inject ISnackbar Snackbar
@inject IDatabaseRepository DatabaseRepository
@inject IExcelService ExcelService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>匯出TableSchema</PageTitle>

<MudText Typo="Typo.h5">匯出TableSchema</MudText>
<MudDivider></MudDivider>

<MudPaper Class="pa-16 ma-2" Outlined="true">
    <div class="d-flex gap-2">
        <MudSelect @bind-Value="selectedDbName" Label="選取資料庫" HelperText="選取資料庫" OpenIcon="@Icons.Material.Filled.LocalDrink" AdornmentColor="Color.Secondary">
            @foreach (string item in databases)
            {
                <MudSelectItem Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
        <MudButton Color="Color.Primary" Variant="@Variant.Outlined" OnClick="ExportSchema">
            匯出Schema
        </MudButton>
    </div>
</MudPaper>

@code {
    private string selectedDbName;
    private List<string> databases = new List<string>();

    protected override async Task OnInitializedAsync()
    {
        databases = (await DatabaseRepository.GetDatabaseNamesAsync()).ToList();
    }

    private async Task ExportSchema()
    {
        if (string.IsNullOrEmpty(selectedDbName))
        {
            // 顯示錯誤訊息，請選擇資料庫
            return;
        }

        string filePath = $"template/my_template.xlsx";
        string templatePath = Path.Combine(Environment.WebRootPath, filePath);
        if (!File.Exists(templatePath))
        {
            Snackbar.Add("template 檔案不存在", Severity.Error);
            return;
        }
        
        var schema = await DatabaseRepository.GetTableSchemaAsync(selectedDbName);
        var tableNames = schema.Select(s => s.TableName).ToList();
        var outputPath = $"{selectedDbName}_schema.xlsx";
        // 使用ExcelService匯出Excel檔案
        var fileContent = await ExcelService.GenerateDocumentAsync(schema, tableNames, templatePath);

        // 呼叫 JS 下載
        await JS.InvokeVoidAsync("downloadFile", outputPath,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            fileContent);
    }
}
