@page "/exportdbschema"
@inject IWebHostEnvironment Environment
@inject ISnackbar Snackbar
@inject IDatabaseRepository DatabaseRepository
@inject IExcelService ExcelService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>匯出TableSchema</PageTitle>

<MudText Typo="Typo.h5">匯出TableSchema</MudText>
<MudDivider></MudDivider>

<MudPaper Class="pa-8 ma-2" Outlined="true">
    <div class="d-flex gap-4" style="width:40%;">
        <MudSelect @bind-Value="selectedDbName" Label="選取資料庫" HelperText="選取資料庫" OpenIcon="@Icons.Material.Filled.FactCheck" AdornmentColor="Color.Secondary">
            @foreach (string item in databases)
            {
                <MudSelectItem Value="@item">@item</MudSelectItem>
            }
        </MudSelect>
        <MudButton Color="Color.Primary" Variant="@Variant.Outlined" OnClick="ExportSchema">
            匯出Schema
        </MudButton>

    </div>
    <div class="d-flex justify-center pa-4">
        @if (_uploading)
        {
            <MudPaper Class="pa-4 mud-width-full flex-wrap d-flex align-center justify-center mud-border-secondary mud-text-secondary p-2"
                      Style="background-color:inherit;width:500px;height:100px;"
                      Outlined="true">

                    <MudProgressLinear Class="mx-2" Color="Color.Tertiary" Size="Size.Large" Value="_uploadValue" Min="_uploadMin" Max="_uploadMax" />
                    @* <p>@ProgressMessage</p> *@
                <MudText Typo="Typo.body1">@ProgressMessage</MudText>
            </MudPaper>
        }
    </div>
</MudPaper>

