@code 
{
    // Export Table Schema
    private string selectedDbName;
    private List<string> databases = new List<string>();
    private bool _uploading;
    private readonly int _uploadMin = 0;
    private readonly int _uploadMax = 100;
    private int _uploadValue = 0;
    private string ProgressMessage = "資料讀取中...";

    protected override async Task OnInitializedAsync()
    {
        databases = (await DatabaseRepository.GetDatabaseNamesAsync()).ToList();
    }

    private async Task ExportSchema()
    {
        if (string.IsNullOrEmpty(selectedDbName))
        {
            // 顯示錯誤訊息，請選擇資料庫
            return;
        }

        string filePath = $"template/my_template.xlsx";
        string templatePath = Path.Combine(Environment.WebRootPath, filePath);
        if (!File.Exists(templatePath))
        {
            Snackbar.Add("template 檔案不存在", Severity.Error);
            return;
        }

        _uploading = true;
        StateHasChanged();

        var schema = await DatabaseRepository.GetTableSchemaAsync(selectedDbName);
        var tableNames = schema.Select(s => s.TableName).ToList();
        var outputPath = $"{selectedDbName}_schema.xlsx";

        // 使用ExcelService匯出Excel檔案
        var progress = new Progress<(int current, int total)>(report =>
        {
            _uploadValue = Convert.ToInt32(report.current / (double)report.total * 100);
            ProgressMessage = $"已完成 {report.current}/{report.total} 個工作表";
            InvokeAsync(StateHasChanged);
        });

        var fileContent = await ExcelService.GenerateDocumentAsync(schema, tableNames, templatePath, progress);

        _uploading = false;
        // 呼叫 JS 下載
        await JS.InvokeVoidAsync("downloadFile", outputPath,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            fileContent);
    }
}
