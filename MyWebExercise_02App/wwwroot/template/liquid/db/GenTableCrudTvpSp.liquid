-- 建立 {{ table.Schema_name }}.tp_{{ table.Table_name }}_Merge
create procedure [{{ table.Schema_name }}].[tp_{{ table.Table_name }}_Merge]
{%- assign param = "" -%}
{%- for column in table.columns -%}
{%- if column.Is_primary_key -%}
{%- if param == "" -%}
@old_{{ column.Column_name }} {{ column.Full_data_type }} = null
{%- assign param = @column.Column_name -%}
{%- else -%}
,@old_{{ column.Column_name }} {{ column.Full_data_type }}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
{%- for column in table.columns -%}
{%- if param == "" -%}
@{{ column.Column_name }} {{ column.Full_data_type }}
{%- assign param = @column.Column_name -%}
{%- else -%}
,@{{ column.Column_name }} {{ column.Full_data_type }}
{%- endif -%}
{%- endfor -%}
as begin  
   --若鍵值舊值為null表示為未更動
{%- for column in table.columns -%}
{%- if column.Is_primary_key -%}
   if (@old_{{ column.Column_name }} is null) set @old_{{ column.Column_name }} = @{{ column.Column_name }}
{%- endif -%}
{%- endfor -%}

   --更新資料
   update [{{ table.Schema_name }}].[{{ table.Table_name }}] set
{%- assign param = "" -%}
{%- for column in table.columns -%}
{%- if param == "" -%}
    [{{ column.Column_name }}] = @{{ column.Column_name }}
{%- assign param = @column.Column_name -%}
{%- else -%}
    ,[{{ column.Column_name }}] = @{{ column.Column_name }}
{%- endif -%}
{%- endfor -%}
{%- assign param = "" -%}
{%- for column in table.columns -%}
{%- if column.Is_primary_key -%}
{%- if param == "" -%}
    where {{ column.Column_name }} = @{{ column.Column_name }}
{%- assign param = @column.Column_name -%}
{%- else -%}
    and {{ column.Column_name }} = @{{ column.Column_name }}
{%- endif -%}
{%- endif -%}
{%- endfor -%}
   --異動資料0筆的話新增
   if (@@rowcount = 0)
   --新增
   insert into [{{ table.Schema_name }}].[{{ table.Table_name }}]
      ({%- assign param = "" -%}{%- for column in table.columns -%}{%- if param == "" -%}[{{ column.Column_name }}]{%- assign param = @column.Column_name -%}{%- else -%},[{{ column.Column_name }}]{%- endif -%}{%- endfor -%})
   values
      ({%- assign param = "" -%}{%- for column in table.columns -%}{%- if param == "" -%}@{{ column.Column_name }}{%- assign param = @column.Column_name -%}{%- else -%},@{{ column.Column_name }}{%- endif -%}{%- endfor -%})
end
GO
