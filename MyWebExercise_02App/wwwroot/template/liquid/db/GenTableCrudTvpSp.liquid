-- Schema建立 {{ table.Schema_name }}
IF Not EXISTS (SELECT 1 FROM sys.schemas WHERE name = '{{ table.Schema_name }}')
BEGIN
    EXEC('CREATE SCHEMA [{{ table.Schema_name }}] AUTHORIZATION [dbo];');    
END



DROP TABLE IF EXISTS {{ table.Schema_name }}.{{ table.Table_name }};
GO

CREATE TABLE [{{ table.Schema_name }}].[{{ table.Table_name }}](
{%- for column in table.Columns -%}
	[{{ column.Column_name }}] {{ column.Full_data_type }}{% if column.Is_nullable == false %} Not{% endif %} NULL,
{%- endfor -%}
 CONSTRAINT [PK_{{ table.Table_name }}] PRIMARY KEY CLUSTERED 
(
	 {{ table.Primary_keys }}
)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF) ON [PRIMARY]
) ON [PRIMARY]
GO

{%- for column in table.Columns -%}
{%- if column._description != null -%}
EXEC sys.sp_addextendedproperty @name=N'MS_Description', @value=N'{{ column.Description }}' , @level0type=N'SCHEMA',@level0name=N'{{ table.Schema_name }}', @level1type=N'TABLE',@level1name=N'{{ table.Table_name }}', @level2type=N'COLUMN',@level2name=N'{{ column.Column_name }}'
GO
{%- endif -%}
{%- endfor -%}

{%- if table._description != null -%}
EXEC sys.sp_addextendedproperty @name=N'MS_Description', @value=N'{{ table.Description }}' , @level0type=N'SCHEMA',@level0name=N'{{ table.Schema_name }}', @level1type=N'TABLE',@level1name=N'{{ table.Table_name }}'
GO
{%- endif -%}





-- 檢查 {{ table.Schema_name }}.tp_{{ table.Table_name }}_Select 是否存在，若存在則刪除
IF OBJECT_ID('{{ table.Schema_name }}.tp_{{ table.Table_name }}_Select', 'P') IS NOT NULL
    DROP PROCEDURE {{ table.Schema_name }}.tp_{{ table.Table_name }}_Select;
GO

-- 建立 {{ table.Schema_name }}.tp_{{ table.Table_name }}_Select
create procedure  {{ table.Schema_name }}.tp_{{ table.Table_name }}_Select
{%- assign param = "" -%}
{%- for column in table.columns -%}
{%- if column.Is_primary_key -%}
{%- if param == "" -%}
@{{ column.Column_name }} {{ column.Tvp_datatype }} readonly
{%- assign param = @column.Column_name -%}
{%- else -%}
,@{{ column.Column_name }} {{ column.Tvp_datatype }} readonly
{%- endif -%}
{%- endif -%}
{%- endfor -%}
as begin  
   -- 依照條件組合動態SQL，TVP傳入0筆表示不作為條件，多個條件之間為and邏輯
   declare @_sql nvarchar(max) = ''
{%- for column in table.columns -%}
{%- if column.Is_primary_key -%}
   if exists (select 1 from @{{ column.Column_name }}) set @_sql = @_sql + ' and exists (select 1 from @{{ column.Column_name }} _tvp where _source.[{{ column.Column_name }}] = _tvp.Value)'
{%- endif -%}
{%- endfor -%}
   if (@_sql <> '') set @_sql = stuff(@_sql, 2, 3, 'where')
   set @_sql = 'select * from [{{ table.Schema_name }}].[{{ table.Table_name }}] _source' + @_sql
   
   -- 執行動態SQL
   declare @_parameterDefine nvarchar(max) = '
{%- assign param = "" -%}
{%- for column in table.columns -%}
{%- if column.Is_primary_key -%}
{%- if param == "" -%}
    @{{ column.Column_name }} {{ column.Tvp_datatype }} readonly
{%- assign param = @column.Column_name -%}
{%- else -%}
    ,@{{ column.Column_name }} {{ column.Tvp_datatype }} readonly
{%- endif -%}
{%- endif -%}
{%- endfor -%}'
   exec sys.sp_executesql @_sql, @_parameterDefine{%- for column in table.columns -%}{%- if column.Is_primary_key -%} ,@{{ column.Column_name }}=@{{ column.Column_name }}{%- endif -%}{%- endfor %}
end
GO




