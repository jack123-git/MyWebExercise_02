USE [{{ table.Database_name }}]
GO

SET ANSI_NULLS ON
GO
SET QUOTED_IDENTIFIER ON
GO


-- 使用者定義型態建立 udt_BigInt
IF NOT EXISTS (SELECT 1 FROM sys.types WHERE name = 'udt_BigInt' AND is_table_type = 1)
BEGIN
    CREATE TYPE [dbo].[udt_BigInt] AS TABLE (
        [Value] BIGINT NULL,
        INDEX [IX_Value] ([Value]));
END

